# The agent's credential: where Plow is, and what to present to it. That is
# everything the image is told. It asks Plow for the rest -- the chat it calls
# home, the relay endpoint it offers tools on -- so those move without this
# file changing.
#
# `bin/plow-activate` writes this file. Filling in a copy of this example by
# hand works too, if you already hold an agent credential.
#
# Rotation is a rewrite of these two lines and `docker compose restart agent`.
# Nothing shells into the agent, and the copy inside its home volume cannot
# reinstate the token this file replaced.
#
# Keep it mode 600: it is a bearer token, and it names the API that token is
# sent to. `plow-activate` writes it that way.

# The Plow API root, WITHOUT /v1 -- the agent appends its own.
PLOW_API_BASE=https://api.plow.co
# The agent's own credential: its chats and its inference, nothing else.
PLOW_AGENT_TOKEN=
