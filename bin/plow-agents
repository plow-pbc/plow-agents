#!/usr/bin/env -S uv run --managed-python --script
# The system Python on macOS predates tomllib, and the python.org build trusts no
# certificate authority until its installer step runs; uv's own Python has neither gap.
# /// script
# requires-python = ">=3.11"
# ///
"""Publish Plow agent images and set this account's profile. Standard library only.

    plow-agents login            one-time: text a code, get an account token for publishing
    plow-agents profile          set or show this account's public profile (--photo takes a file)
    plow-agents image build [IMAGE]   build the current directory for linux/amd64
    plow-agents image show SLUG       Pin (what Plow boots) and Listing (Agent Index)
    plow-agents image set SLUG ...    claim or edit the Index listing; never admit to Plow
    plow-agents image promote SLUG REF | --none [--owner UID]   admit or update the pin, mirrored to the Index
    plow-agents image push [IMAGE] [--promote SLUG]   push and print the digest, or promote that exact digest

Image commands use the same slug for the Plow catalog and the Agent Index.

`login` stores an ACCOUNT token in ~/.config/plow/token; it publishes images and
reads or sets the public profile, so it does travel -- over HTTPS, to Plow. It
never enters a container. Creating, listing and removing agents is latch's: `latch agents`.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import stat
import subprocess
import sys
import tempfile
import time
import tomllib
import urllib.error
import urllib.parse
import urllib.request
from typing import NoReturn

DEFAULT_API_BASE = "https://api.plow.co"
DEFAULT_INDEX_BASE = "https://agent-index-server.vercel.app"
POLL_S = 3
CONFIG_FILE = "plow-agents.toml"
DIGEST = r"sha256:[0-9a-f]{64}"
# Plow caps a profile photo at 5 MB and takes these four formats. Restated
# here only to refuse a file before any request is sent; the server decides.
MAX_PHOTO_BYTES = 5 * 1024 * 1024
PHOTO_SIGNATURES = (b"\x89PNG\r\n\x1a\n", b"\xff\xd8\xff", b"GIF87a", b"GIF89a")
TIMEOUT_S = 900


def log(message: str = "") -> None:
    print(message, file=sys.stderr, flush=True)


def die(message: str) -> NoReturn:
    raise SystemExit(f"plow-agents: {message}")


def request(
    method: str,
    url: str,
    *,
    body: dict | None = None,
    token: str | None = None,
    data: bytes | None = None,
    content_type: str | None = None,
) -> tuple[int, object]:
    """One call, JSON in by default. Returns (status, parsed body); never raises on HTTP status.

    `data`/`content_type` are for the one request that is not JSON in: the
    profile photo upload, which sends the file itself.
    """
    headers = {"Accept": "application/json"}
    if data is None and body is not None:
        data, content_type = json.dumps(body).encode(), "application/json"
    if content_type is not None:
        headers["Content-Type"] = content_type
    if token is not None:
        headers["Authorization"] = f"Bearer {token}"
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    # HTTP is restricted to development hosts; their credentials must bypass proxies.
    open_url = urllib.request.build_opener(urllib.request.ProxyHandler({})).open if req.type == "http" else urllib.request.urlopen
    try:
        with open_url(req, timeout=30) as response:
            raw, status = response.read(), response.status
    except urllib.error.HTTPError as error:
        raw, status = error.read(), error.code
    except OSError as error:
        die(f"cannot reach {url}: {error}")
    try:
        return status, json.loads(raw)
    except ValueError:
        return status, None


def call(method: str, base: str, path: str, **kwargs) -> object:
    """The same call, with a non-2xx as a fatal error rather than a value."""
    status, payload = request(method, base + path, **kwargs)
    if status // 100 != 2:
        detail = payload.get("detail") if isinstance(payload, dict) else None
        if isinstance(detail, dict):
            detail = detail.get("message")
        die(f"{method} {path} answered {status}" + (f": {detail}" if detail else ""))
    return payload


def write_private(path: str, body: str) -> str:
    """Write a mode-600 file atomically. Returns the absolute path.

    The temporary name is unpredictable and created O_EXCL|O_NOFOLLOW, the mode
    is checked rather than assumed, and the rename is last -- so a failed run
    leaves the previous credential intact.
    """
    destination = os.path.abspath(path)
    directory = os.path.dirname(destination)
    os.makedirs(directory, mode=0o700, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(dir=directory, prefix=".plow-agents.", suffix=".new")
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w") as handle:
            handle.write(body)
        if stat.S_IMODE(os.stat(temporary).st_mode) != 0o600:
            die("refusing to install a credential that is not mode 600")
        os.replace(temporary, destination)
    except BaseException:
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise
    return destination


def strip_v1(base: str) -> str:
    """Validate an API root before requests, then remove an optional `/v1`."""
    if not base or any(character in base for character in "\r\n\"\\"):
        die("API base must be nonempty and contain no quotes, backslashes, or newlines")
    base = base.rstrip("/")
    base = base[: -len("/v1")] if base.endswith("/v1") else base
    if not base:
        die("API base must not be empty after normalization")
    return base


def token_path(override: str | None) -> str:
    if override:
        return os.path.abspath(override)
    config = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    return os.path.join(config, "plow", "token")


def account_token(args: argparse.Namespace) -> str:
    path = token_path(args.token_file)
    try:
        with open(path) as handle:
            token = handle.read().strip()
    except OSError:
        die(f"no account token at {path} -- run `plow-agents login` first")
    if not token:
        die(f"{path} is empty -- run `plow-agents login` again")
    return token


# --- verbs -----------------------------------------------------------------


def login(args: argparse.Namespace) -> None:
    payload = call("POST", args.api_base, "/v1/auth/activate", body={"name": "plow-agents"})
    code, secret, send_to = (payload.get(k, "") for k in ("display_code", "activation_secret", "send_to"))
    if not (code and secret and send_to):
        die("activation returned no code, secret or number")
    log("")
    log(f"  Text  Plow Activate: {code}  to  {send_to}")
    log("")
    log("Waiting for that text ...")
    deadline = time.monotonic() + TIMEOUT_S
    while time.monotonic() < deadline:
        status, body = request("POST", args.api_base + "/v1/auth/activate/redeem", body={"activation_secret": secret})
        if status == 410:
            die("the code expired -- it is single-use and time-limited; run login again")
        if status // 100 != 2:
            die(f"redeem answered {status} -- run login again for a fresh code")
        if isinstance(body, dict) and body.get("status") == "verified":
            token = body.get("token") or ""
            if not token:
                die("activation verified but returned no token")
            written = write_private(token_path(args.token_file), token + "\n")
            log(f"Wrote {written} (mode 600). This is your ACCOUNT token -- it stays here.")
            return
        time.sleep(POLL_S)
    die(f"timed out after {TIMEOUT_S}s waiting for the text")


def is_hosted_url(value: str) -> bool:
    """Whether a `--photo` value names something already hosted, or a file here.

    The scheme decides, and schemes are case-insensitive: a prefix test that
    was not read `HTTPS://example.com/ada.jpg` as a filename, and went looking
    for it on disk. Anything urlsplit cannot parse is treated as a path, which
    is where an unparseable value gets the error that names it -- `cannot
    read`, with the value in it -- instead of a traceback.
    """
    try:
        return urllib.parse.urlsplit(value).scheme.lower() in ("http", "https")
    except ValueError:
        return False


def read_photo(path: str) -> bytes:
    """The file's bytes, refused here rather than over the network if unusable.

    Everything knowable without asking Plow is settled before the first
    request goes out, because `profile` may be writing a name too: a file that
    turns out to be unopenable, oversized, or not an image AFTER the name has
    landed is a command that half happened. Plow checks all of it again -- it
    has to, this is not its only client -- and stays the authority; this is
    only about not starting what cannot finish.
    """
    try:
        with open(path, "rb") as handle:
            content = handle.read(MAX_PHOTO_BYTES + 1)
    except OSError as error:
        die(f"cannot read {path}: {error}")
    if len(content) > MAX_PHOTO_BYTES:
        die(f"{path} is larger than {MAX_PHOTO_BYTES // (1024 * 1024)} MB")
    if not (content.startswith(PHOTO_SIGNATURES) or (content[:4] == b"RIFF" and content[8:12] == b"WEBP")):
        die(f"{path} is not a PNG, JPEG, GIF, or WebP image")
    return content


def upload_photo(api_base: str, token: str, path: str, content: bytes, name: str | None) -> object:
    """Send the image, and the display name with it. Returns the profile Plow answers with.

    One request, because that route writes both in the transaction that stores
    the bytes. Uploading and then PATCHing the name meant a failure at the
    second call left the photo stored and public beside the name it was sent
    to replace, and nothing here could say which half had happened.
    """
    # RFC 7578, standard library, the one non-JSON request this tool makes. A
    # quote, backslash or newline in the filename would rewrite the header
    # around it, so only a conservative set of characters survives into it.
    # The part's own type is left as octet-stream: Plow reads the signature of
    # the bytes rather than anything the uploader claims, so a guess here
    # would only be a guess.
    boundary = "----plow-agents-" + os.urandom(16).hex()
    filename = "".join(c if c.isalnum() or c in "._-" else "_" for c in os.path.basename(path)) or "photo"
    body = b""
    if name is not None:
        body += f'--{boundary}\r\nContent-Disposition: form-data; name="display_name"\r\n\r\n{name}\r\n'.encode()
    body += (
        f"--{boundary}\r\n"
        f'Content-Disposition: form-data; name="file"; filename="{filename}"\r\n'
        "Content-Type: application/octet-stream\r\n\r\n"
    ).encode() + content + f"\r\n--{boundary}--\r\n".encode()
    return call(
        "POST",
        api_base,
        "/v1/auth/profile/photo",
        token=token,
        data=body,
        content_type=f"multipart/form-data; boundary={boundary}",
    )


def profile(args: argparse.Namespace) -> None:
    token = account_token(args)
    if args.show:
        if args.name is not None or args.photo is not None:
            die("profile --show cannot be combined with --name or --photo")
        result = call("GET", args.api_base, "/v1/auth/profile", token=token)
        result["uid"] = call("GET", args.api_base, "/v1/auth/owner-uid", token=token)["owner_uid"]
        print(json.dumps(result, sort_keys=True))
        return
    if args.name is None and args.photo is None:
        die("profile needs --name, --photo, or --show")

    # A photo already hosted somewhere public is just a field, so it travels in
    # the same PATCH as the name. A local file is not a field: it is uploaded,
    # and that route takes the name alongside it and writes both as it stores
    # the bytes. Either way this is exactly one request, so a run either
    # happened or it did not -- there is no half of it to be left behind.
    upload = args.photo is not None and not is_hosted_url(args.photo)
    content = read_photo(args.photo) if upload else b""
    if upload:
        result = upload_photo(args.api_base, token, args.photo, content, args.name)
    else:
        body = {}
        if args.name is not None:
            body["display_name"] = args.name
        if args.photo is not None:
            body["photo_url"] = args.photo
        result = call("PATCH", args.api_base, "/v1/auth/profile", token=token, body=body)
    print(json.dumps(result, sort_keys=True))


def project() -> dict[str, str]:
    try:
        with open(CONFIG_FILE, "rb") as handle:
            settings = tomllib.load(handle)
    except FileNotFoundError:
        return {}
    except tomllib.TOMLDecodeError as error:
        die(f"{CONFIG_FILE}: {error}")
    if any(key != "image" or not isinstance(value, str) for key, value in settings.items()):
        die(f"{CONFIG_FILE} accepts only an image string")
    return settings


def project_image(image: str | None) -> str:
    if image is None:
        image = project().get("image", "")
    if not image:
        die(f"pass IMAGE or set image in ./{CONFIG_FILE}")
    if image.startswith("-") or "@" in image or "/" not in image or any(c.isspace() for c in image):
        die("image must be a registry/repository:tag")
    host = image.split("/", 1)[0]
    if "." not in host.split(":", 1)[0]:
        die("image needs an explicit registry host, such as docker.io or ghcr.io")
    return image


def image_repository(image: str) -> str:
    host, name = image.split("/", 1)
    return f"{host}/{name.rsplit(':', 1)[0]}"


def dockerignore_patterns(path: str) -> list[tuple[re.Pattern[str], bool]]:
    try:
        with open(path, encoding="utf-8-sig") as handle:
            lines = handle.readlines()
    except FileNotFoundError:
        return []
    patterns = []
    for line in lines:
        if line.startswith("#") or not line.strip():
            continue
        pattern = line.strip()
        exclude = not pattern.startswith("!")
        pattern = os.path.normpath(pattern if exclude else pattern[1:].strip()).strip("/")
        if pattern == ".":
            continue
        # Docker globs are rooted, match parent directories, and apply in order.
        tokens = re.findall(r"\\.|\*\*/?|\[(?:\\.|[^\\\]])*\]|.", pattern)
        expression = ""
        for index, token in enumerate(tokens):
            if token.startswith("**"):
                expression += ".*" if index == len(tokens) - 1 else "(?:.*/)?"
            elif token == "*":
                expression += "[^/]*"
            elif token == "?":
                expression += "[^/]"
            elif token.startswith("["):
                expression += "(?!/)" + token
            else:
                expression += re.escape(token[1:] if token.startswith("\\") else token)
        patterns.append((re.compile(expression + r"(?:/.*)?\Z", re.DOTALL), exclude))
    return patterns


def refuse_credentials(args: argparse.Namespace, ignore_file: str) -> None:
    account_file = os.path.realpath(token_path(args.token_file))
    patterns = dockerignore_patterns(ignore_file)
    def failed(error: OSError) -> NoReturn:
        die(f"cannot check build context for credentials: {error}")
    for directory, _, files in os.walk(".", onerror=failed):
        for filename in files:
            path = os.path.join(directory, filename)
            relative = os.path.relpath(path)
            excluded = False
            for pattern, exclude in patterns:
                if pattern.match(relative):
                    excluded = exclude
            # Docker always reads the build Dockerfile, even when ignored.
            if excluded and relative != "Dockerfile":
                continue
            if os.path.realpath(path) == account_file:
                die(f"add {relative} to {ignore_file} before building")
            try:
                with open(path, "rb") as handle:
                    if any(b"PLOW_AGENT_TOKEN=" in line or line.lstrip().startswith(b"# plow-agent-uid:") for line in handle):
                        if relative == "Dockerfile":
                            die("remove credentials from Dockerfile before building")
                        die(f"add {relative} to {ignore_file} before building")
            except OSError as error:
                failed(error)


def docker(*arguments: str) -> str:
    command = ["docker", *arguments]
    log("$ " + " ".join(command))
    try:
        result = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False)
    except OSError as error:
        die(f"cannot run docker: {error}")
    log(result.stdout.rstrip())
    if result.stderr:
        log(result.stderr.rstrip())
    if result.returncode:
        die(f"docker {' '.join(arguments)} failed ({result.returncode})")
    return result.stdout


def image_build(args: argparse.Namespace) -> None:
    image = project_image(args.image)
    refuse_credentials(args, "Dockerfile.dockerignore" if os.path.exists("Dockerfile.dockerignore") else ".dockerignore")
    docker("build", "--platform", "linux/amd64", "--tag", image, ".")


def image_push(args: argparse.Namespace) -> None:
    image = project_image(args.image)
    found = re.findall(r"digest: (" + DIGEST + r")\b", docker("push", image))
    if not found:
        die("docker push printed no sha256 digest")
    ref = f"{image_repository(image)}@{found[-1]}"
    if args.promote:
        promote_image(args, args.promote, ref)
    else:
        print(ref)


def agent_image_path(slug: str) -> str:
    return "/v1/agent-images/" + urllib.parse.quote(slug.removeprefix("exe:"), safe="")


def index_listing(args: argparse.Namespace, slug: str) -> dict | None:
    # fresh=1: the Index CDN-caches this read for 20s, and this runs right after
    # an image set or promote, so the cached copy would show the old image.
    path = "/v1/agent?" + urllib.parse.urlencode({"agent_id": slug, "fresh": "1"})
    url = args.index_base + path
    status, payload = request("GET", url)
    if status == 404:
        if not (isinstance(payload, dict) and payload.get("ok") is False
                and isinstance(payload.get("error"), str) and payload["error"]):
            die(f"misconfigured Index base: {url} answered {status} without an Index JSON error")
        log(f"{slug}: not on the Agent Index")
        return None
    if status // 100 != 2:
        die(f"Agent Index read answered {status}: {payload}")
    return payload


def update_index(args: argparse.Namespace, slug: str, body: dict, token: str, *, promoting: bool = False) -> None:
    log("Updating Agent Index listing...")
    if promoting and index_listing(args, slug) is None:
        return
    identity = call("GET", args.api_base, "/v1/auth/index-identity", token=token)
    path = "/v1/agents?" + urllib.parse.urlencode({"agent_id": slug})
    status, payload = request("POST", args.index_base + path, token=identity["assertion"], body=body)
    if status == 409:
        message = f"you do not own {slug} on the Agent Index"
        if promoting:
            log(f"Index skipped: {message}; Plow updated")
            return
        die(message)
    if status // 100 != 2:
        die(f"Agent Index update answered {status}: {payload}")
    if payload.get("dropped"):
        die(f"Agent Index refused fields: {', '.join(payload['dropped'])}")
    log("Index updated")


def image_show(args: argparse.Namespace) -> None:
    row = call("GET", args.api_base, agent_image_path(args.slug))
    site = index_listing(args, row["slug"])
    print(json.dumps({"plow": row, "index": site}, indent=2))


def promote_image(args: argparse.Namespace, slug: str, image: str | None, *, owner: str | None = None) -> None:
    token = account_token(args)
    path = agent_image_path(slug)
    status, row = request("GET", args.api_base + path)
    creating = status == 404
    if not creating and status // 100 != 2:
        die(f"Plow agent image read answered {status}: {row}")
    body = {"image": image}
    if creating:
        if owner is None:
            die("creating a Plow row requires --owner <plow user uid>; nothing was sent")
        slug = slug.removeprefix("exe:")
        listing = index_listing(args, slug)
        if listing is None:
            die("register it on the leaderboard first (image set)")
        body.update(name=listing["name"], phrases=[f"Set this up for me: aiworthusing.com/agent-index/{slug}"], owner_uid=owner)
    elif owner is not None:
        log("--owner ignored: this image is already admitted to Plow")
    status, row = request("PUT", args.api_base + path, token=token, body=body)
    if status == 404:
        die("not admitted to Plow yet; ask an admin")
    if status == 403:
        die(f"you do not own {slug} (an allowlisted Plow admin may also promote)")
    if status // 100 != 2:
        die(f"Plow pin refused ({status}): {row}")
    log("Plow admitted" if creating else "Plow updated")
    print(json.dumps(row, indent=2))
    update_index(args, row["slug"], {"image": row["image"] if row["image"] is not None else ""}, token, promoting=True)


def image_promote(args: argparse.Namespace) -> None:
    promote_image(args, args.slug, args.ref, owner=args.owner)


def image_set(args: argparse.Namespace) -> None:
    pin = {field: getattr(args, flag) for flag, field in
           (("phrase", "phrases"), ("owner", "owner_uid"), ("enabled", "enabled"))
           if getattr(args, flag) is not None}
    site_fields = (("name", "name"), ("blurb", "blurb"), ("repo", "repo"), ("video", "video"),
                   ("link", "install_url"), ("screenshot", "images"))
    site = {field: getattr(args, flag) for flag, field in site_fields if getattr(args, flag) is not None}
    if not pin and not site:
        die("image set needs at least one metadata flag; use image promote to change the image")
    token = account_token(args)
    path = agent_image_path(args.slug)
    status, row = request("GET", args.api_base + path)
    creating = status == 404
    if not creating and status // 100 != 2:
        die(f"Plow agent image read answered {status}: {row}")
    if creating and pin:
        die("not admitted to Plow yet; an admin promotes it first")
    if pin:
        row = call("PUT", args.api_base, path, token=token, body=pin)
        log("Plow updated")
    print(json.dumps(None if creating else row, indent=2))
    if site:
        update_index(args, args.slug.removeprefix("exe:"), site, token)


def main() -> int:
    parser = argparse.ArgumentParser(prog="plow-agents", description=__doc__.splitlines()[0])
    parser.add_argument("--api-base", default=DEFAULT_API_BASE, help=f"Plow API root, without /v1 (default {DEFAULT_API_BASE})")
    parser.add_argument("--token-file", default=None, help="account token (default ~/.config/plow/token)")
    parser.add_argument("--index-base", default=os.environ.get("PLOW_INDEX_BASE", DEFAULT_INDEX_BASE),
                        help=f"Agent Index root (env PLOW_INDEX_BASE; default {DEFAULT_INDEX_BASE})")
    verbs = parser.add_subparsers(dest="verb", required=True)

    it = verbs.add_parser("login", help="text a code, store this account's token for publishing images and the profile",
                          description="Text a code and store this account's token, used only to publish images and set the profile. Agents log in with latch.")
    it.set_defaults(run=login)

    it = verbs.add_parser("profile", help="set or show this account's public profile")
    it.add_argument("--name", help="public display name")
    it.add_argument("--photo", help="a local image file, or a public https URL")
    it.add_argument("--show", action="store_true", help="show the current profile")
    it.set_defaults(run=profile)

    it = verbs.add_parser("image", help="build, push, inspect, edit, or promote an agent image")
    images = it.add_subparsers(dest="image_verb", required=True)
    for verb, run in (("build", image_build), ("push", image_push)):
        image = images.add_parser(verb, help=f"{verb} an image")
        image.add_argument("image", nargs="?", metavar="IMAGE", help="registry/repository:tag")
        if verb == "push":
            image.add_argument("--promote", metavar="SLUG", help="promote this push's digest to an agent image and mirror it to the Index")
        image.set_defaults(run=run)

    show = images.add_parser("show", help="Pin (what Plow boots) and Listing (Agent Index); no token needed")
    show.add_argument("slug")
    show.set_defaults(run=image_show)
    promote = images.add_parser("promote", help="promote or clear the image pin",
                                  description="Set the Plow image pin, mirrored to the listing on the Agent Index. An older digest rolls back.")
    promote.add_argument("slug")
    promote.add_argument("--owner", metavar="UID", help="Plow user UID; required for an admin to admit a new image")
    target = promote.add_mutually_exclusive_group(required=True)
    target.add_argument("ref", nargs="?", metavar="REF", help="registry/repository@sha256:<64 hex>")
    target.add_argument("--none", action="store_true", help="clear both pins and prevent new provisions")
    promote.set_defaults(run=image_promote)
    edit = images.add_parser("set", help="edit metadata; use promote for the image",
                               description="Set only the metadata flags supplied. The image pin is never changed.")
    edit.add_argument("slug")
    pin = edit.add_argument_group("Pin (what Plow boots)", "Plow admin only; the image must already be admitted.")
    pin.add_argument("--phrase", action="append", help="signup phrase; repeat to replace the phrase list")
    pin.add_argument("--owner", help="Plow owner UID")
    enabled = pin.add_mutually_exclusive_group()
    enabled.add_argument("--enabled", dest="enabled", action="store_true", default=None)
    enabled.add_argument("--disabled", dest="enabled", action="store_false")
    site = edit.add_argument_group("Listing (Agent Index)", "Claim an unregistered slug or update a listing you own.")
    for flag in ("name", "blurb", "repo"):
        site.add_argument("--" + flag)
    site.add_argument("--video", type=json.loads, metavar="JSON", help='video object: {"provider":"youtube","id":"...","title":"..."}')
    site.add_argument("--link", help="installation/tutorial HTTPS URL; empty string clears")
    site.add_argument("--screenshot", action="append", metavar="URL", help="repeat to replace the screenshot list")
    edit.set_defaults(run=image_set)

    args = parser.parse_args()
    # Every path here starts with /v1, so a /v1 in the base would 404 every call.
    bases = ["api_base"]
    if args.verb == "image" and (args.image_verb in {"show", "set", "promote"} or (args.image_verb == "push" and args.promote)):
        bases.append("index_base")
    for option in bases:
        base = strip_v1(getattr(args, option))
        endpoint = urllib.parse.urlsplit(base)
        host = endpoint.hostname or ""
        local = host in ("localhost", "127.0.0.1", "::1") or host.endswith(".orb.local")
        if not host or not (endpoint.scheme == "https" or endpoint.scheme == "http" and local):
            die(f"--{option.replace('_', '-')} requires HTTPS except for localhost, 127.0.0.1, ::1, or *.orb.local")
        setattr(args, option, base)
    args.run(args)
    return 0


if __name__ == "__main__":
    sys.exit(main())
