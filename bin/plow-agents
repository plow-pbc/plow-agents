#!/usr/bin/env python3
"""Manage the Plow agents on your account. Standard library only.

    plow-agents login            one-time: text a code, get an account token
    plow-agents login --new-line same, and be given an assistant line
    plow-agents lines            the assistant lines this account holds, and who
                                 is already answering on each
    plow-agents mint <line-uid>  that line's credential -> ./plow-credentials
    plow-agents profile          set or show this account's public profile
    plow-agents revoke [line]    revoke a local credential by file or line

`login` stores an ACCOUNT token in ~/.config/plow/token; it lists, mints and
revokes, so it does travel -- over HTTPS, to Plow. What it never does is enter a
container. `mint` uses it for an AGENT credential scoped to one line, and that
second one is the only credential a container ever sees.
"""

from __future__ import annotations

import argparse
import json
import os
import stat
import sys
import tempfile
import time
import urllib.error
import urllib.request
from typing import NoReturn

DEFAULT_API_BASE = "https://api.plow.co"
CREDENTIAL_FILE = "plow-credentials"
POLL_S = 3
TIMEOUT_S = 900


def log(message: str = "") -> None:
    print(message, file=sys.stderr, flush=True)


def die(message: str) -> NoReturn:
    raise SystemExit(f"plow-agents: {message}")


def request(method: str, url: str, *, body: dict | None = None, token: str | None = None) -> tuple[int, object]:
    """One JSON call. Returns (status, parsed body); never raises on HTTP status."""
    data = json.dumps(body).encode() if body is not None else None
    headers = {"Accept": "application/json"}
    if data is not None:
        headers["Content-Type"] = "application/json"
    if token is not None:
        headers["Authorization"] = f"Bearer {token}"
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=30) as response:
            raw, status = response.read(), response.status
    except urllib.error.HTTPError as error:
        raw, status = error.read(), error.code
    except OSError as error:
        die(f"cannot reach {url}: {error}")
    try:
        return status, json.loads(raw)
    except ValueError:
        return status, None


def call(method: str, base: str, path: str, **kwargs) -> object:
    """The same call, with a non-2xx as a fatal error rather than a value."""
    status, payload = request(method, base + path, **kwargs)
    if status // 100 != 2:
        detail = payload.get("detail") if isinstance(payload, dict) else None
        die(f"{method} {path} answered {status}" + (f": {detail}" if detail else ""))
    return payload


def write_private(path: str, body: str) -> str:
    """Write a mode-600 file atomically. Returns the absolute path.

    The temporary name is unpredictable and created O_EXCL|O_NOFOLLOW, the mode
    is checked rather than assumed, and the rename is last -- so a failed run
    leaves the previous credential intact.
    """
    destination = os.path.abspath(path)
    directory = os.path.dirname(destination) or "."
    os.makedirs(directory, mode=0o700, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(dir=directory, prefix=".plow-agents.", suffix=".new")
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w") as handle:
            handle.write(body)
        if stat.S_IMODE(os.stat(temporary).st_mode) != 0o600:
            die("refusing to install a credential that is not mode 600")
        os.replace(temporary, destination)
    except BaseException:
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise
    return destination


def credential_key_id(path: str, keys: object, *, tolerate_unmatched: bool = False) -> str | None:
    """Find the one API key whose published prefix matches this credential."""
    try:
        with open(path) as handle:
            content = handle.read()
    except OSError:
        return None
    tokens = [line.split("=", 1)[1] for line in content.splitlines() if line.startswith("PLOW_AGENT_TOKEN=")]
    token = tokens[0] if len(tokens) == 1 and tokens[0].startswith("plow_") else ""
    prefix = token[5:13]
    if not prefix:
        if tolerate_unmatched:
            return ""
        die(f"no valid agent token in {path} -- revoke it in the Plow dashboard and delete the file")
    # Plow auth.py derives KeyInfo.key_prefix from the same slice of the token.
    matches = [
        str(key["id"])
        for key in (keys if isinstance(keys, list) else [])
        if (key_prefix := key.get("key_prefix")) and token[5:5 + len(key_prefix)] == key_prefix
    ]
    if not matches:
        if tolerate_unmatched:
            return ""
        die(f"no key matches the token in {path} -- revoke it in the Plow dashboard and delete the file")
    if len(matches) > 1:
        if tolerate_unmatched:
            return ""
        die(f"more than one key matches the token in {path} -- revoke in the Plow dashboard")
    return matches[0]


def revoke_key(args: argparse.Namespace, key_id: str, token: str) -> None:
    """Retire one key. A key Plow no longer knows is the state we were after."""
    status, payload = request("DELETE", args.api_base + f"/v1/api-keys/{key_id}", token=token)
    if status == 404:
        return
    if status // 100 != 2:
        detail = payload.get("detail") if isinstance(payload, dict) else None
        die(f"could not revoke key {key_id}: {status}" + (f": {detail}" if detail else ""))


def strip_v1(base: str) -> str:
    """An API root the agent can append its own `/v1` to."""
    base = base.rstrip("/")
    return base[: -len("/v1")] if base.endswith("/v1") else base


def token_path(override: str | None) -> str:
    if override:
        return os.path.abspath(override)
    config = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    return os.path.join(config, "plow", "token")


def account_token(args: argparse.Namespace) -> str:
    path = token_path(args.token_file)
    try:
        with open(path) as handle:
            token = handle.read().strip()
    except OSError:
        die(f"no account token at {path} -- run `plow-agents login` first")
    if not token:
        die(f"{path} is empty -- run `plow-agents login` again")
    return token


# --- verbs -----------------------------------------------------------------


def account_lines(chats: object) -> dict[str, tuple[str, str]]:
    """The assistant lines a GET /v1/chats body shows, uid -> (name, number).

    A line is not listed in its own right: it is the identity the agent side of
    a chat answers on, so the chats are where to read one off."""
    seen: dict[str, tuple[str, str]] = {}
    for chat in chats.get("data", []) if isinstance(chats, dict) else []:
        for participant in chat.get("participants", []):
            line = participant.get("line") if participant.get("type") == "agent" else None
            if isinstance(line, dict) and line.get("uid"):
                seen.setdefault(line["uid"], (line.get("display_name") or "", line.get("provider_key") or ""))
    return seen


def line_holders(keys: object) -> dict[str, list[tuple[str, str]]]:
    """Who is already answering on each line, uid -> [(kind, id)].

    One call answers it. A key carries both the line its grant resolves to and
    the cloud agent it belongs to, so a cloud agent needs no second lookup --
    `GET /v1/agents/cloud` publishes no line at all, only the agent.

    A key whose grant does not resolve to one line -- an account-wide one, this
    tool's own included -- has no `assistant_line` and so holds nothing here.
    That is the question being asked: not who *could* write to the line, but who
    is an assistant on it.
    """
    holders: dict[str, list[tuple[str, str]]] = {}
    for key in keys if isinstance(keys, list) else []:
        line = key.get("assistant_line") or {}
        if not line.get("uid") or not key.get("is_active"):
            continue
        agent_uid = key.get("agent_id")
        holders.setdefault(line["uid"], []).append(
            ("cloud", str(agent_uid)) if agent_uid else ("local", str(key["id"]))
        )
    return holders


def format_holder(holder: tuple[str, str]) -> str:
    return f"{holder[0]} {holder[1]}"


def login(args: argparse.Namespace) -> None:
    # `provision_chat` asks for a line and a chat on it in the same handshake:
    # a real change to the account, and one nothing here can undo. So it is
    # asked for only when you say so. Nothing on this machine can decide it
    # either -- a cached token is evidence about whoever logged in last, which
    # need not be the account about to text the code below.
    payload = call("POST", args.api_base, "/v1/auth/activate", body={"name": "plow-agents", "provision_chat": args.new_line})
    code, secret, send_to = (payload.get(k, "") for k in ("display_code", "activation_secret", "send_to"))
    if not (code and secret and send_to):
        die("activation returned no code, secret or number")
    log("")
    log(f"  Text  Plow Activate: {code}  to  {send_to}")
    log("")
    log("Waiting for that text ...")
    deadline = time.monotonic() + TIMEOUT_S
    while time.monotonic() < deadline:
        status, body = request("POST", args.api_base + "/v1/auth/activate/redeem", body={"activation_secret": secret})
        if status == 410:
            die("the code expired -- it is single-use and time-limited; run login again")
        if status // 100 != 2:
            die(f"redeem answered {status} -- run login again for a fresh code")
        if isinstance(body, dict) and body.get("status") == "verified":
            token = body.get("token") or ""
            if not token:
                die("activation verified but returned no token")
            written = write_private(token_path(args.token_file), token + "\n")
            log(f"Wrote {written} (mode 600). This is your ACCOUNT token -- it stays here.")
            # Now that a token is in hand, this account can be asked about
            # itself -- and `mint` has nothing to scope a credential to
            # without a line, so say so here rather than two verbs later.
            status, body = request("GET", args.api_base + "/v1/chats", token=token)
            if status // 100 == 2 and not account_lines(body):
                log("This account holds no assistant line yet: run `plow-agents login --new-line` to be given one.")
            return
        time.sleep(POLL_S)
    die(f"timed out after {TIMEOUT_S}s waiting for the text")


def lines(args: argparse.Namespace) -> None:
    token = account_token(args)
    seen = account_lines(call("GET", args.api_base, "/v1/chats", token=token))
    if not seen:
        log("No assistant lines on this account yet.")
        log("Run `plow-agents login --new-line` to be given one.")
        return
    holders = line_holders(call("GET", args.api_base, "/v1/api-keys", token=token))
    print("LINE\tNAME\tNUMBER\tSTATUS")
    for uid, (name, number) in sorted(seen.items()):
        status = ", ".join(format_holder(holder) for holder in holders.get(uid, [])) or "free"
        print(f"{uid}\t{name}\t{number}\t{status}")


def profile(args: argparse.Namespace) -> None:
    token = account_token(args)
    updated = None
    if args.name is not None or args.photo is not None:
        if args.name is None or args.photo is None:
            die("profile requires both --name and --photo")
        updated = call(
            "PATCH",
            args.api_base,
            "/v1/auth/profile",
            token=token,
            body={"display_name": args.name, "photo_url": args.photo},
        )
    if args.show or updated is None:
        status, shown = request("GET", args.api_base + "/v1/auth/profile", token=token)
        if status // 100 == 2:
            updated = shown
        elif updated is None:
            die(f"GET /v1/auth/profile answered {status}")
    print(json.dumps(updated, sort_keys=True))


def mint(args: argparse.Namespace) -> None:
    line_uid = args.line
    destination = os.path.abspath(CREDENTIAL_FILE)
    if os.path.isdir(destination):
        die(
            f"{destination} is a directory -- run `docker compose down -v && "
            "rmdir plow-credentials`, then mint again"
        )
    account = account_token(args)
    keys = call("GET", args.api_base, "/v1/api-keys", token=account)
    # Writing over a credential without retiring its key would leave a live
    # token no file on this machine names. So the old key goes first -- read
    # before anything can fail, revoked as late as possible before the new one.
    superseded = credential_key_id(destination, keys)
    # Two agents on one line both answer, and the owner cannot tell which. So
    # the line is checked before anything is written -- and before the revoke
    # below, which would otherwise retire a working credential on the way to a
    # refusal. The key this file already names is not a conflict: re-minting
    # over it is the ordinary rotation, and it is retired two lines down.
    held = [holder for holder in line_holders(keys).get(line_uid, []) if holder != ("local", superseded)]
    if held:
        names = ", ".join(format_holder(holder) for holder in held)
        die(f"line:{line_uid} is already answering as {names} -- revoke that one first")
    if superseded is not None:
        revoke_key(args, superseded, account)
        log(f"Revoked key {superseded}, the one {destination} named.")
    # The agent's scopes are the server's to decide, not this tool's: naming a
    # line here asks for the assistant role, and asking for it by scope list on
    # /v1/api-keys is how a self-hosted agent ends up with a grant that covers
    # today's threads on the number but not tomorrow's.
    body = {"name": "plow-agent", "line_uid": line_uid}
    minted = call("POST", args.api_base, "/v1/relay/agents", token=account, body=body)
    token, key_id = minted.get("token"), minted.get("id")
    if not token or key_id is None:
        die("the mint returned no token or no id")
    scopes = minted.get("scopes") or []
    # A token carrying these would break out of its own line in the file below.
    if any(character in token for character in "\r\n\"\\"):
        die("the minted token carries quote or newline characters")
    credential = f"PLOW_API_BASE={args.agent_api_base}\nPLOW_AGENT_TOKEN={token}\n"
    written = write_private(destination, credential)
    log(f"Minted key {key_id} for line:{line_uid}, scoped to {' '.join(scopes)}.")
    log(f"Wrote {written} (mode 600).")


def revoke(args: argparse.Namespace) -> None:
    """Revoke the credential file's key, or recover one local key by line."""
    path = os.path.abspath(CREDENTIAL_FILE)
    account = account_token(args)
    keys = call("GET", args.api_base, "/v1/api-keys", token=account)
    if args.line:
        line_uid = args.line
        holders = line_holders(keys).get(line_uid, [])
        if len(holders) != 1:
            die(f"line:{line_uid} has {len(holders)} active holders -- expected exactly one local credential")
        kind, key_id = holders[0]
        if kind != "local":
            die(f"line:{line_uid} is held by {format_holder(holders[0])} -- delete that agent in Plow")
    else:
        key_id = credential_key_id(path, keys)
        if key_id is None:
            die(f"no credential file at {path}")
    revoke_key(args, key_id, account)
    log(f"Revoked key {key_id}.")
    if args.line:
        file_key_id = credential_key_id(path, keys, tolerate_unmatched=True)
        if file_key_id is None:
            return
        if not file_key_id:
            log(f"Left {path} in place: its token does not identify one key.")
            return
        if file_key_id != key_id:
            log(f"Left {path} in place: it names key {file_key_id}, not the revoked key {key_id}.")
            return
    try:
        os.unlink(path)
    except OSError as error:
        log(f"{path} could not be removed ({error}). It names a dead key; delete it yourself.")
        raise SystemExit(2)
    log(f"Removed {path}.")


def main() -> int:
    parser = argparse.ArgumentParser(prog="plow-agents", description=__doc__.splitlines()[0])
    parser.add_argument("--api-base", default=DEFAULT_API_BASE, help=f"Plow API root, without /v1 (default {DEFAULT_API_BASE})")
    parser.add_argument("--token-file", default=None, help="account token (default ~/.config/plow/token)")
    verbs = parser.add_subparsers(dest="verb", required=True)

    it = verbs.add_parser("login", help="text a code, store this account's token")
    it.add_argument("--new-line", action="store_true", help="also have Plow give this account a new assistant line and a chat on it")
    it.set_defaults(run=login)

    verbs.add_parser("lines", help="the assistant lines this account holds").set_defaults(run=lines)

    it = verbs.add_parser("profile", help="set or show this account's public profile")
    it.add_argument("--name", help="public display name")
    it.add_argument("--photo", help="public https photo URL")
    it.add_argument("--show", action="store_true", help="read the current profile after updating")
    it.set_defaults(run=profile)

    it = verbs.add_parser("mint", help="a credential for one line, written to ./plow-credentials")
    it.add_argument("line", help="line uid, as printed by `lines`")
    it.add_argument("--agent-api-base", default=None, help="the API root written into the credential, if the container reaches Plow at a different address than this machine does (default: --api-base)")
    it.set_defaults(run=mint)

    it = verbs.add_parser("revoke", help="revoke ./plow-credentials, or one local credential by line")
    it.add_argument("line", nargs="?", help="line uid whose sole local credential should be revoked")
    it.set_defaults(run=revoke)

    args = parser.parse_args()
    # The agent builds `${PLOW_API_BASE}/v1`, so a /v1 here would 404 every call.
    args.api_base = strip_v1(args.api_base)
    # `--api-base` is where *this tool* calls; the credential says where the
    # *container* calls. The same address usually, but not against a local
    # stack: a 127.0.0.1 that works out here is the container's own loopback.
    if getattr(args, "agent_api_base", None) is None:
        args.agent_api_base = args.api_base
    else:
        args.agent_api_base = strip_v1(args.agent_api_base)
    args.run(args)
    return 0


if __name__ == "__main__":
    sys.exit(main())
