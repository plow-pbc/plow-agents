#!/usr/bin/env python3
"""Measure what prompt caching costs and saves, on a real agent. Stdlib only.

    bench-cache run --image <ref@sha256:...> --line ln_xxx --label before
    bench-cache report run-before-1.json run-after-1.json

One variant per `run`: boot an agent from ONE image digest, drive a fixed
conversation through Plow, read the usage rows that conversation produced, tear
the agent down. Two runs of two images is the before/after; the conversation is
`bench/conversation.json`, so the image under test is the only thing that
differs between them.

Nothing here decides anything. It boots what you name, on the line you name,
and prints what it measured -- including the parts it could not measure, which
is the whole point of the header it writes at the top of every report.

Auth is `plow-agents`'s: this shells out to it for `mint` and `revoke`, and
reads the same account token. Usage rows have no owner-facing API -- `/v1/usage`
aggregates, and never splits prompt from completion or carries the cache
counters -- so they come from a SQL command you supply with `--usage-cmd`:
`plow-ops db query {sql}` against prod, a `docker exec ... psql` against a local
compose stack. Same code path either way.

Turns are delivered as INBOUND messages through the LinQ twin, because that is
what an agent answers; see `drive_twin`. That is the one part of this harness a
production run cannot reuse as-is.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, NoReturn

DEFAULT_API_BASE = "https://api.plow.co"
TOKEN_FILE = Path.home() / ".config" / "plow" / "token"
BOOT_MARKER = "plow-init: configured"
BOOT_TIMEOUT_S = 600
POLL_S = 2

# The row shape #1710 adds. Absent on an older API build, and its absence is
# reported rather than defaulted to zero: "no cache columns" and "cached
# nothing" are the two readings a benchmark must never confuse.
CACHE_COLUMNS = ("cache_read_tokens", "cache_write_tokens")
BASE_COLUMNS = ("id", "session_id", "created_at", "model", "prompt_tokens", "completion_tokens", "total_tokens", "cost_usd", "status")


def log(message: str = "") -> None:
    print(message, file=sys.stderr, flush=True)


def die(message: str) -> NoReturn:
    raise SystemExit(f"bench-cache: {message}")


def now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M:%S")


def run(argv: list[str], **kwargs: Any) -> subprocess.CompletedProcess[str]:
    return subprocess.run(argv, text=True, capture_output=True, **kwargs)


def api_json(method: str, url: str, token: str | None = None, body: dict | None = None) -> tuple[int, Any]:
    data = json.dumps(body).encode() if body is not None else None
    headers = {"Accept": "application/json"}
    if token is not None:
        headers["Authorization"] = f"Bearer {token}"
    if data is not None:
        headers["Content-Type"] = "application/json"
    request = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(request, timeout=60) as response:
            raw, status = response.read(), response.status
    except urllib.error.HTTPError as error:
        raw, status = error.read(), error.code
    except OSError as error:
        die(f"cannot reach {url}: {error}")
    try:
        return status, json.loads(raw or b"null")
    except ValueError:
        return status, raw.decode(errors="replace")


# -- the parts that touch the world ------------------------------------------


def write_compose(directory: Path, image: str, project: str, platform: str | None, network: str | None, env: list[str]) -> Path:
    """The `Test a new image` compose, with the image pinned by digest.

    Digest, never a tag: this container is handed a credential carrying
    `relay:call` and `payments:request`, and a tag is only wherever it was last
    pushed to point. `run` refuses anything else.
    """
    platform_line = f"    platform: {platform}\n" if platform else ""
    # A local API runs in its own compose project; the agent has to be on that
    # network to resolve it. Prod needs none of this -- the agent dials out.
    network_lines = f"    networks:\n      - target\n" if network else ""
    network_block = f"networks:\n  target:\n    name: {network}\n    external: true\n" if network else ""
    # Whatever the operator adds must be added to EVERY variant of a comparison
    # or the runs differ in more than the image, which is the one thing this
    # tool exists to prevent. It is printed in the report header for that reason.
    env_lines = ("    environment:\n" + "".join(f"      {k}: \"{v}\"\n" for k, v in (e.split("=", 1) for e in env))) if env else ""
    (directory / "compose.yml").write_text(
        f"name: {project}\n"
        "services:\n"
        "  agent:\n"
        f"    image: {image}\n"
        f"{platform_line}"
        "    volumes:\n"
        "      - ./plow-credentials:/var/lib/plow/credentials.host:ro\n"
        "      - agent-home:/var/lib/hermes\n"
        "    stop_grace_period: 35s\n"
        f"{env_lines}"
        f"{network_lines}"
        "volumes:\n"
        "  agent-home:\n"
        f"{network_block}"
    )
    return directory / "compose.yml"


def boot(directory: Path, line: str, api_base: str, plow_agents: str, token_file: Path, agent_api_base: str | None) -> int:
    """Mint, start, wait for the agent to take its line. Returns its session id.

    That id is the whole of this run's identity in `llm_usage`: on a shared
    account -- which production is -- a time window alone sums every agent, and
    every human, that happened to be talking to the model while this ran. The
    window is a convenience; the session is the answer.
    """
    mint = [plow_agents, "--api-base", api_base, "--token-file", str(token_file), "mint", line]
    if agent_api_base:
        # What the CONTAINER dials, which is not what this CLI dials when the
        # API is a local one: the host sees 127.0.0.1:<port>, the container sees
        # a service name on the API's own network.
        mint += ["--agent-api-base", agent_api_base]
    minted = run(mint, cwd=directory)
    if minted.returncode != 0:
        die(f"mint failed for {line}: {minted.stderr.strip() or minted.stdout.strip()}")
    found = re.search(r"Minted key (\d+) ", minted.stdout + minted.stderr)
    if not found:
        die("could not read the minted key id from plow-agents -- refusing to run, "
            "because without it the usage query is scoped by time alone and would "
            "sum every other agent on the account")
    session_id = int(found.group(1))
    up = run(["docker", "compose", "up", "-d"], cwd=directory)
    if up.returncode != 0:
        die(f"compose up failed: {up.stderr.strip()}")
    deadline = time.time() + BOOT_TIMEOUT_S
    while time.time() < deadline:
        logs = run(["docker", "compose", "logs", "--no-color", "agent"], cwd=directory)
        if BOOT_MARKER in logs.stdout:
            log(f"booted: {[l for l in logs.stdout.splitlines() if BOOT_MARKER in l][-1].strip()} (session {session_id})")
            return session_id
        if "plow-init:" in logs.stdout and "configured" not in logs.stdout:
            failure = [l for l in logs.stdout.splitlines() if "plow-init:" in l][-3:]
            if any("exit" in l.lower() or "refus" in l.lower() for l in failure):
                die("plow-init failed:\n  " + "\n  ".join(failure))
        time.sleep(POLL_S)
    die(f"no {BOOT_MARKER!r} within {BOOT_TIMEOUT_S}s -- the agent never took its line")


def teardown(directory: Path, api_base: str, plow_agents: str, token_file: Path, keep: bool) -> None:
    """Revoke first, then remove the container and its home.

    Revoke first on purpose: `compose down -v` deletes the home the credential
    was mounted into, and a credential outliving the agent that held it is the
    one piece of this that is not merely untidy.
    """
    revoked = run([plow_agents, "--api-base", api_base, "--token-file", str(token_file), "revoke"], cwd=directory)
    output = (revoked.stdout + revoked.stderr).strip()
    log(f"revoke: {output.splitlines()[-1] if output else 'no output'}")
    run(["docker", "compose", "down", "-v"], cwd=directory)
    if keep:
        log(f"--keep: leaving {directory} -- it holds a live agent credential until you revoke it")
    else:
        # The scratch directory is where `mint` wrote ./plow-credentials. Revoke
        # deletes that file; anything short of a clean revoke leaves a working
        # credential on disk, so the directory goes only when the revoke did.
        if revoked.returncode == 0:
            shutil.rmtree(directory, ignore_errors=True)
    if revoked.returncode != 0:
        die(f"revoke failed (rc={revoked.returncode}) -- a live credential is still in {directory}: {output}")


def home_chat(token: str, api_base: str, line: str) -> str:
    status, body = api_json("GET", f"{api_base}/v1/chats", token)
    if status != 200 or not isinstance(body, dict):
        die(f"GET /v1/chats -> {status}: {body}")
    for chat in body.get("data", []):
        lines = [p.get("line", {}).get("uid") for p in chat.get("participants", [])]
        if line in lines and chat.get("status") == "active":
            return chat["uid"]
    die(f"no active chat on {line} -- has the agent greeted it yet?")


def _twin_outbound(twin_base: str, phone: str) -> list[dict]:
    """Every outbound message the twin holds for *phone*, across its line chats."""
    status, chats = api_json("GET", f"{twin_base}/ui/chats")
    if status != 200 or not isinstance(chats, dict):
        return []
    messages: list[dict] = []
    for chat in chats.get("chats", []):
        if chat.get("remote_phone") != phone:
            continue
        status, detail = api_json("GET", f"{twin_base}/ui/chats/{chat['id']}")
        if status != 200 or not isinstance(detail, dict):
            continue
        messages += [m for m in detail.get("messages", []) if m.get("direction") == "outbound"]
    return messages


def drive_twin(twin_base: str, phone: str, to_phone: str, turns: list[str], reply_timeout_s: int) -> list[dict]:
    """Drive the agent the way its owner does: an inbound text, then wait.

    The owner-side chat API is not a driver. `POST /v1/chats/{uid}/messages`
    sends AS the line -- it is the side the agent itself writes on -- so a turn
    posted there is not a message the agent answers. What the agent answers is
    an INBOUND message from the remote phone, which on a local stack is the
    LinQ twin's `/ui/inbound` and in production is a real handset. That is the
    one part of this harness a prod run cannot reuse as-is.

    ttft_s is the wall time to the FIRST new outbound message, and total_s to
    the last one before the agent goes quiet: an agent that narrates before its
    final tool call sends several, and the turn is not over at the first.
    """
    records = []
    for index, text in enumerate(turns, start=1):
        seen = {m.get("id") for m in _twin_outbound(twin_base, phone)}
        sent_at = time.time()
        # `to_phone` is not optional here, whatever the twin's default is: it
        # picks the LINE the message lands on, and a message on another line is
        # one this agent never sees. Omitting it costs a silent no-op run --
        # every turn times out, no completion is made, and the usage table stays
        # empty while the agent looks perfectly healthy.
        status, _ = api_json("POST", f"{twin_base}/ui/inbound",
                             body={"to_phone": to_phone, "remote_phone": phone, "text": text})
        if status not in (200, 201):
            die(f"turn {index}: twin /ui/inbound -> {status}")
        first_reply_at: float | None = None
        last_seen: float | None = None
        replies: list[str] = []
        deadline = sent_at + reply_timeout_s
        while time.time() < deadline:
            time.sleep(POLL_S)
            fresh = [m for m in _twin_outbound(twin_base, phone) if m.get("id") not in seen and m.get("id") not in replies]
            if fresh:
                if first_reply_at is None:
                    first_reply_at = time.time()
                last_seen = time.time()
                replies += [m.get("id") for m in fresh]
            if first_reply_at is not None and last_seen is not None and time.time() - last_seen > 3 * POLL_S:
                break
        records.append(
            {
                "turn": index,
                "text": text,
                "sent_at": datetime.fromtimestamp(sent_at, timezone.utc).strftime("%Y-%m-%d %H:%M:%S"),
                "ttft_s": round(first_reply_at - sent_at, 2) if first_reply_at else None,
                "total_s": round((last_seen or time.time()) - sent_at, 2),
                "replies": len(replies),
                "timed_out": first_reply_at is None,
            }
        )
        log(f"turn {index:>2}: ttft={records[-1]['ttft_s']}s total={records[-1]['total_s']}s replies={len(replies)}")
    return records


def usage_rows(usage_cmd: str, started: str, ended: str, session_id: int | None) -> tuple[list[dict], list[str], str | None]:
    """The usage rows this run produced, read through `--usage-cmd`.

    One command template with a `{sql}` slot, so prod and a local stack differ
    by a flag rather than a code path: `plow-ops db query {sql}` against prod,
    `docker exec ... psql ... -c {sql}` against a compose database. It must emit
    CSV with one header row.

    Returns (rows, columns, note). `note` is set when the API build behind the
    run recorded no cache counters -- the caller reports that instead of
    printing zeros, which would read as "cached nothing" rather than "did not
    measure".
    """
    def sql(statement: str) -> tuple[int, str, str]:
        argv = shlex.split(usage_cmd.replace("{sql}", "\x00"))
        argv = [statement if part == "\x00" else part for part in argv]
        done = run(argv)
        return done.returncode, done.stdout, done.stderr

    code, out, err = sql(
        "SELECT column_name FROM information_schema.columns WHERE table_name = 'llm_usage'"
    )
    if code != 0:
        return [], [], f"column probe failed ({usage_cmd.split()[0]}): {err.strip() or out.strip()}"
    present = {line.split(",")[0].strip() for line in out.splitlines()[1:] if line.strip()}
    if not present:
        return [], [], "column probe returned no columns -- is llm_usage there, and does --usage-cmd emit CSV?"
    missing = [column for column in CACHE_COLUMNS if column not in present]
    columns = [c for c in list(BASE_COLUMNS) + list(CACHE_COLUMNS) if c in present]
    # `+00` on both literals: the window is recorded in UTC, and an unqualified
    # literal is read in the server's timezone the day this column becomes a
    # timestamptz -- silently shifting every window by the offset. Harmless on
    # the naive column it is today, correct on either.
    where = f"created_at >= '{started}+00' AND created_at <= '{ended}+00'"
    if session_id is None:
        die("refusing to read usage without a session id -- a time window alone "
            "sums every account active in it")
    where += f" AND session_id = {session_id}"
    code, out, err = sql(f"SELECT {', '.join(columns)} FROM llm_usage WHERE {where} ORDER BY created_at")
    if code != 0:
        return [], columns, f"usage query failed: {err.strip() or out.strip()}"
    # psql -A prints a `(N rows)` footer; it parsed as a data row and inflated
    # every request count by one.
    lines = [l for l in out.splitlines() if l.strip() and not re.fullmatch(r"\(\d+ rows?\)", l.strip())]
    header_row = [c.strip() for c in lines[0].split(",")] if lines else columns
    rows = [dict(zip(header_row, [v.strip() for v in line.split(",")])) for line in lines[1:]]
    note = None
    if missing:
        note = (
            f"this API build has no {', '.join(missing)} on llm_usage -- it predates plow #1710, "
            "so cache reads and writes were NOT recorded and the cache-hit ratio cannot be computed from Plow. "
            "On the streaming path that build also prices a cache read at the full input rate, so cost_usd "
            "for a caching variant would be an over-estimate."
        )
    return rows, columns, note


# -- reporting ---------------------------------------------------------------


def to_number(value: str | None) -> float:
    try:
        return float(value)
    except (TypeError, ValueError):
        return 0.0


def summarise(record: dict) -> dict:
    rows = record["usage_rows"]
    turns = record["turns"]
    ttfts = [t["ttft_s"] for t in turns if t["ttft_s"] is not None]
    prompt = sum(to_number(r.get("prompt_tokens")) for r in rows)
    completion = sum(to_number(r.get("completion_tokens")) for r in rows)
    read = sum(to_number(r.get("cache_read_tokens")) for r in rows) if record["has_cache_columns"] else None
    write = sum(to_number(r.get("cache_write_tokens")) for r in rows) if record["has_cache_columns"] else None
    # `prompt_tokens` already CONTAINS the cache counters -- litellm folds
    # cache-read and cache-write into it while also carrying them separately
    # (anthropic/chat/transformation.py, and #1710's own comment). Adding them
    # again halves every hit ratio this tool reports. Measured on a real row:
    # prompt=19306, read=19209, write=95 -- the two counters ARE the prompt.
    billed_input = prompt
    return {
        "requests": len(rows),
        "turns": len(turns),
        "timed_out_turns": sum(1 for t in turns if t["timed_out"]),
        "prompt_tokens": int(prompt),
        "completion_tokens": int(completion),
        "cache_read_tokens": int(read) if read is not None else None,
        "cache_write_tokens": int(write) if write is not None else None,
        "cache_hit_ratio": round(read / billed_input, 4) if read is not None and billed_input else None,
        "cost_usd": round(sum(to_number(r.get("cost_usd")) for r in rows), 6),
        "mean_ttft_s": round(sum(ttfts) / len(ttfts), 2) if ttfts else None,
        "mean_turn_s": round(sum(t["total_s"] for t in turns) / len(turns), 2) if turns else None,
    }


def header(record: dict) -> list[str]:
    return [
        f"## {record['label']}",
        "",
        "| what | value |",
        "|---|---|",
        f"| image | `{record['image']}`{'' if record.get('image_pinned', True) else ' — **not digest-pinned** (locally built)'} |",
        f"| line | `{record['line']}` |",
        f"| session | {record.get('session_id') or '**unscoped**'} |",
        f"| agent env | {', '.join(record.get('agent_env') or []) or 'none'} |",
        f"| api base | {record['api_base']} |",
        f"| api revision | {record['api_revision'] or '**unverified** (no version endpoint; pass --api-revision)'} |",
        f"| conversation | `{record['conversation']}` ({len(record['turns'])} turns) |",
        f"| window (UTC) | {record['started']} → {record['ended']} |",
        f"| cache columns | {'present' if record['has_cache_columns'] else '**absent** (API predates plow #1710)'} |",
        "",
    ]


def render(records: list[dict]) -> str:
    out: list[str] = ["# bench-cache", "", f"Rendered {now()} UTC.", ""]
    for record in records:
        out += header(record)
        if record.get("note"):
            out += [f"> {record['note']}", ""]
        out += ["| turn | ttft s | total s | replies | timed out |", "|---:|---:|---:|---:|---|"]
        for turn in record["turns"]:
            out.append(f"| {turn['turn']} | {turn['ttft_s'] if turn['ttft_s'] is not None else '—'} | {turn['total_s']} | {turn['replies']} | {'YES' if turn['timed_out'] else ''} |")
        summary = summarise(record)
        out += ["", "| metric | value |", "|---|---:|"]
        for key, value in summary.items():
            out.append(f"| {key} | {'—' if value is None else value} |")
        out.append("")
    if len(records) >= 2:
        before, after = summarise(records[0]), summarise(records[-1])
        out += ["## before → after", "", "| metric | before | after | change |", "|---|---:|---:|---:|"]
        for key in ("cost_usd", "prompt_tokens", "cache_read_tokens", "cache_hit_ratio", "mean_ttft_s"):
            b, a = before.get(key), after.get(key)
            if b is None or a is None:
                change = "— (not measured)"
            elif b:
                change = f"{(a - b) / b * 100:+.1f}%"
            else:
                change = "n/a"
            out.append(f"| {key} | {'—' if b is None else b} | {'—' if a is None else a} | {change} |")
        out.append("")
    return "\n".join(out)


# -- entry points ------------------------------------------------------------


def cmd_run(args: argparse.Namespace) -> None:
    if "@sha256:" not in args.image and not args.allow_local_image:
        die("--image must be pinned by digest (repo@sha256:...); pass --allow-local-image for one you built yourself")
    token_file = Path(args.token_file) if args.token_file else TOKEN_FILE
    if not token_file.exists():
        die(f"no account token at {token_file} -- run `plow-agents login` first")
    token = token_file.read_text().strip()
    plow_agents = args.plow_agents or shutil.which("plow-agents") or str(Path(__file__).with_name("plow-agents"))
    conversation = json.loads(Path(args.conversation).read_text())

    directory = Path(args.workdir or f"./bench-{args.label}-{int(time.time())}").resolve()
    directory.mkdir(parents=True, exist_ok=False)
    write_compose(directory, args.image, args.project or f"agent-bench-{args.label}", args.platform, args.network, args.agent_env)
    log(f"scratch: {directory}")

    started = now()
    turns: list[dict] = []
    session_id = args.session_id
    try:
        session_id = boot(directory, args.line, args.api_base, plow_agents, token_file, args.agent_api_base)
        chat = home_chat(token, args.api_base, args.line)
        log(f"chat: {chat}")
        turns = drive_twin(args.twin_base, args.from_phone, args.to_phone, conversation["turns"], conversation.get("reply_timeout_s", 300))
    finally:
        ended = now()
        teardown(directory, args.api_base, plow_agents, token_file, args.keep)

    out = Path(args.out or f"run-{args.label}-{started.replace(' ', 'T').replace(':', '')}.json")
    record = {
        "label": args.label,
        "image": args.image,
        "line": args.line,
        "api_base": args.api_base,
        "api_revision": args.api_revision,
        "conversation": args.conversation,
        "image_pinned": "@sha256:" in args.image,
        "agent_env": args.agent_env,
        "session_id": session_id,
        "started": started,
        "ended": ended,
        "turns": turns,
        "usage_rows": [],
        "has_cache_columns": False,
        "note": None,
    }
    # The turns cost real money and forty minutes; the usage read is a lookup
    # that can fail for reasons that have nothing to do with them (no plow-ops
    # on PATH, an expired tunnel). Write what is already measured first, then
    # enrich it -- so a lookup failure costs the query, not the run.
    out.write_text(json.dumps(record, indent=1))
    try:
        rows, columns, note = usage_rows(args.usage_cmd, started, ended, session_id)
    except OSError as error:
        rows, columns, note = [], [], f"usage command could not run ({error}) -- timings are intact; re-read with `bench-cache report` after fixing it"
        log(f"usage read failed: {error}")
    record.update(
        usage_rows=rows,
        has_cache_columns=all(c in columns for c in CACHE_COLUMNS),
        note=note,
    )
    out.write_text(json.dumps(record, indent=1))
    log(f"raw: {out}")
    print(render([record]))


def cmd_report(args: argparse.Namespace) -> None:
    print(render([json.loads(Path(p).read_text()) for p in args.records]))


def main() -> None:
    parser = argparse.ArgumentParser(prog="bench-cache", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)

    r = sub.add_parser("run", help="boot one image, drive the conversation, read its usage, tear down")
    r.add_argument("--image", required=True, help="repo@sha256:... -- digest, never a tag")
    r.add_argument("--line", required=True, help="line uid; must be `free` in `plow-agents lines`")
    r.add_argument("--label", required=True, help="before | after | anything you will recognise")
    r.add_argument("--api-base", default=DEFAULT_API_BASE)
    r.add_argument("--api-revision", default=None, help="the deployed API sha, for the report header")
    r.add_argument("--conversation", default=str(Path(__file__).resolve().parent.parent / "bench" / "conversation.json"))
    r.add_argument("--project", default=None, help="compose project name; must be unique per concurrent run")
    r.add_argument("--platform", default=None, help="e.g. linux/amd64 when the image arch differs")
    r.add_argument("--agent-api-base", default=None, help="what the CONTAINER dials, when that differs from --api-base (a local stack)")
    r.add_argument("--agent-env", action="append", default=[], metavar="KEY=VALUE", help="env for the agent container; use the SAME set for every variant")
    r.add_argument("--network", default=None, help="existing docker network to join, e.g. a local API's compose network")
    r.add_argument("--twin-base", required=True, help="LinQ twin base URL -- the only way to send the agent an INBOUND message on a local stack")
    r.add_argument("--from-phone", required=True, help="the remote phone the scripted turns come from")
    r.add_argument("--to-phone", required=True, help="the LINE's number -- which line the inbound lands on, and so which agent sees it")
    r.add_argument("--workdir", default=None)
    r.add_argument("--session-id", type=int, default=None, help="scope the usage query to one session")
    r.add_argument("--token-file", default=None)
    r.add_argument("--plow-agents", default=None)
    r.add_argument("--out", default=None)
    r.add_argument("--allow-local-image", action="store_true", help="accept a tag: an image you built, not one you were handed")
    r.add_argument(
        "--usage-cmd",
        default="plow-ops db query {sql}",
        help="command that runs one SQL statement and prints CSV; {sql} is the slot. "
             "Local stack: 'docker exec -i <db-container> psql -U plow -d plow -A -F, -c {sql}'",
    )
    r.add_argument("--keep", action="store_true", help="leave the container up after the run")
    r.set_defaults(func=cmd_run)

    p = sub.add_parser("report", help="re-render one or more saved runs; first is before, last is after")
    p.add_argument("records", nargs="+")
    p.set_defaults(func=cmd_report)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
