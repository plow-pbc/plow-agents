[Unit]
Description=Wake the CoS sous for the priority nudge routine

[Service]
Type=oneshot
# Edit all three for your CoS: its kitchen socket, the Swarm rooms holding the
# priorities (space-separated), and this repo's deployed clone.
Environment=KITCHEN_SOCK=%h/.claude-kitchen/kitchen-agents-cos/kitchen.sock
Environment=PRIORITIES_ROOM=#general
ExecStart=/usr/bin/python3 -I %h/services/plow-agents/agents/cos/wake.py
