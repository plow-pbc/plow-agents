#!/bin/bash
# Install superpowers, accept Claude's one-time prompts, then keep the feedback
# sous running in tmux. Exits (and compose restarts it) if tmux dies.
set -euo pipefail
claude plugin list 2>/dev/null | grep -q superpowers@claude-plugins-official || {
  claude plugin marketplace add anthropics/claude-plugins-official
  claude plugin install superpowers@claude-plugins-official
}

# Onboarding, folder trust (on $HOME, which covers ~/feedback) and the bypass warning.
[ -f ~/.claude.json ] || echo '{}' >~/.claude.json
jq --arg h "$HOME" '.hasCompletedOnboarding=true | .projects[$h].hasTrustDialogAccepted=true' \
  ~/.claude.json >~/.claude.json.new && mv ~/.claude.json.new ~/.claude.json
[ -f ~/.claude/settings.json ] || { mkdir -p ~/.claude && echo '{}' >~/.claude/settings.json; }
jq '.skipDangerousModePermissionPrompt=true' ~/.claude/settings.json >~/.claude/settings.json.new \
  && mv ~/.claude/settings.json.new ~/.claude/settings.json

mkdir -p ~/feedback && cp /opt/feedback/CLAUDE.md ~/feedback/CLAUDE.md
tmux new-session -d -s feedback -c ~/feedback \
  'while true; do kitchen open --model opus --resume || kitchen open --model opus; sleep 5; done'
# The sous loads swarm as a development channel; confirm that dialog (its first
# option is preselected) only while it is up, before Claude's welcome banner.
while tmux has-session -t feedback 2>/dev/null; do
  pane=$(tmux capture-pane -p -t feedback)
  if grep -q "Loading development channels" <<<"$pane" && ! grep -q "Claude Code v" <<<"$pane"; then
    tmux send-keys -t feedback Enter
  fi
  sleep 5
done
